# Skopiuj do .env, podaj własne hasło i właściwą nazwę bazy.
DATABASE_URL=postgresql+psycopg://it:YOUR_PASSWORD@51.77.35.130:5432/YOUR_DATABASE
APP_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Nowe pliki: database lub s3. Po zmianie konfiguracji zrestartuj API.
FILE_STORAGE=database
S3_ENDPOINT_URL=https://s3.hostava.pl
S3_REGION=auto
S3_BUCKET=katias3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# WhatsApp Business Cloud API — instrukcja: docs/whatsapp.md
# Token wyłącznie na backendzie. Wersja API zgodna z aplikacją Meta (vNN.0).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=pl
WHATSAPP_LINK_TEMPLATE=space_flow_link
WHATSAPP_REMINDER_TEMPLATE=space_flow_reminder
# Po konfiguracji ustaw true: wysyłka codziennie od 09:00 Europe/Warsaw,
# dzień przed terminem, wyłącznie dla klientów włączonych w Ustawieniach.
WHATSAPP_AUTO_REMINDERS=false
# Publiczny adres HTTPS frontendu, bez # i parametrów.
PUBLIC_APP_URL=

# SMSAPI.pl — token OAuth i zaakceptowane pole nadawcy z panelu SMSAPI.
# Metodę domyślną i automatyczne przypomnienia wybierz w Ustawienia → Powiadomienia.
SMSAPI_ACCESS_TOKEN=
SMSAPI_SENDER=

# Opcjonalne podsumowanie AI na stronie Start. Bez klucza działa zwykłe zestawienie.
# Do OpenAI przesyłane są tylko liczby spraw i data, bez danych klientów.
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
